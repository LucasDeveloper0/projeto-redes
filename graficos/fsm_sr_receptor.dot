// FSM do receptor da Repetição Seletiva. Gerar a imagem com:
//   dot -Tpng -Gdpi=150 graficos/fsm_sr_receptor.dot -o graficos/fsm_sr_receptor.png
// Estados = elipses; cada transição = caixa amarela (evento / ação).
digraph sr_receptor {
  rankdir=TB; nodesep=0.7; ranksep=0.8; pad=0.5;
  label="FSM do receptor da Repetição Seletiva (janela de recepção de tamanho N)"; labelloc=t; fontsize=15;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=ellipse, style=filled, fillcolor="#fbf0ee"];
  edge [fontname="Helvetica", fontsize=9];

  ini [shape=point, width=0.15, fillcolor="black", label=""];
  rx  [label="Espera\njanela [rcv_base, rcv_base + N - 1]\n(rcv_base = 0, buffer vazio)"];
  fim [label="Concluído", shape=doublecircle, fillcolor="#e6f4ea"];

  node [shape=box, style="rounded,filled", fillcolor="#fff8e1", fontsize=10];
  t_ordem   [label="evento: íntegro, seq == rcv_base\nação: ACK seq ; entrega seq e os seguintes\njá guardados no buffer ; rcv_base avança"];
  t_buffer  [label="evento: íntegro, rcv_base < seq < rcv_base + N, novo\nação: ACK seq ; guarda no buffer"];
  t_dup     [label="evento: íntegro, seq < rcv_base ou já no buffer (duplicado)\nação: reenvia ACK seq ; não entrega de novo"];
  t_ignora  [label="evento: corrompido ou seq ≥ rcv_base + N\nação: descarta, sem ACK"];
  t_fim     [label="evento: FIM entregue (rcv_base > seq_fim)\nação: responde repetições durante o linger ; encerra"];

  ini -> rx;
  rx -> t_ordem -> rx;
  rx -> t_buffer -> rx;
  rx -> t_dup -> rx;
  rx -> t_ignora -> rx;
  rx -> t_fim -> fim;
}
