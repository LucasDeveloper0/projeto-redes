// FSM do remetente da Repetição Seletiva. Gerar a imagem com:
//   dot -Tpng -Gdpi=150 graficos/fsm_sr_remetente.dot -o graficos/fsm_sr_remetente.png
// Estados = elipses azuis; cada transição = caixa amarela (evento / ação).
digraph sr_remetente {
  rankdir=TB; nodesep=0.7; ranksep=0.8; pad=0.5;
  label="FSM do remetente da Repetição Seletiva (janela de tamanho N)"; labelloc=t; fontsize=15;
  fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=ellipse, style=filled, fillcolor="#eef3fb"];
  edge [fontname="Helvetica", fontsize=9];

  ini [shape=point, width=0.15, fillcolor="black", label=""];
  vazia [label="Janela vazia\nnenhum temporizador ligado\nbase == proximo"];
  transito [label="Pacotes em trânsito\num temporizador por pacote sem ACK\nbase < proximo"];
  fim [label="Concluído", shape=doublecircle, fillcolor="#e6f4ea"];

  // transições (caixas)
  node [shape=box, style="rounded,filled", fillcolor="#fff8e1", fontsize=10];
  t_primeiro [label="evento: há dados\nação: make(DADOS, proximo) ; sendto ;\nligar temporizador de proximo ; proximo++"];
  t_envia    [label="evento: há dados e proximo < base + N\nação: make(DADOS, proximo) ; sendto ;\nligar temporizador de proximo ; proximo++"];
  t_ack      [label="evento: ACK íntegro, base ≤ ack < proximo, ainda não confirmado\nação: marca SÓ o pacote ack ; desliga o temporizador dele ;\nenquanto base confirmado: base++"];
  t_ignora   [label="evento: ACK corrompido, repetido ou fora da janela\nação: descarta"];
  t_timeout  [label="evento: timeout do pacote k\nação: retransmite SÓ o pacote k ;\nreligar temporizador de k"];
  t_esvazia  [label="evento: ACK íntegro que confirma o último pacote sem ACK\nação: base avança até proximo"];
  t_fim      [label="evento: ACK do pacote FIM (base > seq_fim)\nação: encerra a transferência"];

  ini -> vazia;
  vazia -> t_primeiro -> transito;
  transito -> t_envia -> transito;
  transito -> t_ack -> transito;
  transito -> t_ignora -> transito;
  transito -> t_timeout -> transito;
  transito -> t_esvazia -> vazia;
  vazia -> t_fim -> fim;
}
